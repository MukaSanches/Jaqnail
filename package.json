{
  "name": "jaqnail",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "author": "Samuel Sanches",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test src/tests/*.test.ts",
    "test:ci": "npm test && npm run test:ui",
    "test:ui": "jest --runInBand",
    "prebuild": "expo prebuild --platform android --no-install",
    "format": "prettier --write App.tsx src scripts/*.py docs/*.md",
    "format:check": "prettier --check App.tsx \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "8.6.0",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "expo": "55.0.0",
    "expo-build-properties": "55.0.18",
    "expo-crypto": "55.0.19",
    "expo-document-picker": "55.0.17",
    "expo-file-system": "55.0.26",
    "expo-notifications": "55.0.27",
    "expo-sharing": "55.0.24",
    "expo-splash-screen": "55.0.25",
    "expo-sqlite": "55.0.20",
    "expo-status-bar": "55.0.6",
    "expo-system-ui": "55.0.0",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-safe-area-context": "5.6.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "eslint": "9.39.1",
    "jest": "29.7.0",
    "jest-expo": "55.0.0",
    "prettier": "3.7.4",
    "react-test-renderer": "19.2.0",
    "sharp": "0.34.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  }
}
